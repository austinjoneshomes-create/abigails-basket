---
import { NAP } from '../config/site';
interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Ready to make your move?',
  text = 'Whether you’re buying your first home in Pasadena or scaling a multifamily portfolio across Houston, let’s talk strategy.',
} = Astro.props;
---
<section class="border-t-2 border-gold-500 bg-ivory-200">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-14 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="font-display text-3xl font-medium text-ink-900 md:text-4xl">{heading}</h2>
      <p class="mt-3 max-w-xl text-ink-700">{text}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <a href="/contact/" class="bg-ink-900 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.18em] text-ivory-50 transition-colors hover:bg-ink-950">
        Book a consultation
      </a>
      <a href={NAP.phoneHref} class="border border-ink-900 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.18em] text-ink-900 transition-colors hover:bg-ink-900 hover:text-ivory-50">
        Call {NAP.phone}
      </a>
    </div>
  </div>
</section>
