---
import { NAP } from '../config/site';
interface Props {
  heading?: string;
  text?: string;
}
const {
  heading = 'Ready to make your move?',
  text = 'Whether you’re buying your first home in Pasadena or scaling a multifamily portfolio across Houston, let’s talk strategy.',
} = Astro.props;
---
<section class="bg-gold-500">
  <div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-4 py-12 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="font-display text-2xl font-bold text-ink-900 md:text-3xl">{heading}</h2>
      <p class="mt-2 max-w-xl text-ink-800">{text}</p>
    </div>
    <div class="flex shrink-0 flex-wrap gap-3">
      <a href="/contact/" class="rounded-md bg-ink-900 px-6 py-3 font-semibold text-ivory-50 transition-colors hover:bg-ink-700">
        Book a consultation
      </a>
      <a href={NAP.phoneHref} class="rounded-md border-2 border-ink-900 px-6 py-3 font-semibold text-ink-900 transition-colors hover:bg-ink-900 hover:text-ivory-50">
        Call {NAP.phone}
      </a>
    </div>
  </div>
</section>
