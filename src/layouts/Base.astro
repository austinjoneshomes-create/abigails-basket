---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, BRAND } from '../config/site';
import { defaultGraph } from '../config/schema';

export interface Props {
  title: string;
  description: string;
  /** Path-only canonical, e.g. "/about/". Defaults to current URL path. */
  path?: string;
  /** Absolute or root-relative OG image. Defaults to site OG image. */
  ogImage?: string;
  ogType?: string;
  /** Extra JSON-LD graphs (breadcrumbs, podcast, etc.) for this page. */
  schemas?: unknown[];
  noindex?: boolean;
}

const {
  title,
  description,
  path,
  ogImage = '/og-default.png',
  ogType = 'website',
  schemas = [],
  noindex = false,
} = Astro.props;

const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, SITE_URL).href;
const absoluteOg = new URL(ogImage, SITE_URL).href;
const fullTitle = title.includes(BRAND.name) ? title : `${title} | ${BRAND.name}`;

const graphs = [defaultGraph(), ...schemas];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="author" content={`${BRAND.owner} — ${BRAND.name}`} />
    <meta name="geo.region" content="US-TX" />
    <meta name="geo.placename" content="Houston, Pasadena, Texas" />
    <meta name="theme-color" content="#141A4B" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={BRAND.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={absoluteOg} />
    <meta property="og:image:alt" content={`${BRAND.name} — Houston & Pasadena, TX`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOg} />

    <link rel="sitemap" href="/sitemap-index.xml" />

    {graphs.map((g) => (
      <script type="application/ld+json" set:html={JSON.stringify(g)} />
    ))}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ink-900 focus:px-4 focus:py-2 focus:text-ivory-50"
      >Skip to content</a
    >
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
