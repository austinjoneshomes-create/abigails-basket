<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Space City Exchange | Austin From Houston Presents</title>
<meta name="description" content="Houston, we have a network. An invite-only referral network evening for top agents during KW Family Reunion 2027. Sunday, February 21, 2027, 6:30 PM to 9:30 PM CT, Houston.">
<meta name="robots" content="noindex">
<meta property="og:title" content="Space City Exchange | Austin From Houston Presents">
<meta property="og:description" content="Houston, we have a network. Invite-only referral network evening during KW Family Reunion 2027. Sunday, February 21, 2027, 6:30 PM CT. Date and time subject to change.">
<meta name="theme-color" content="#0b1d3a">
<style is:inline>
:root{--navy:#0b1d3a;--deep:#061229;--panel:rgba(16,40,78,.72);--gold:#e8b04a;--orange:#e9772e;--ink:#f4f6fb;--muted:#b9c4da;--line:rgba(232,176,74,.45)}
*{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;color:var(--ink);line-height:1.55;
background:radial-gradient(ellipse at 50% 0%,#17386a 0%,var(--navy) 45%,var(--deep) 100%) fixed;background-color:var(--deep);min-height:100vh}
body:before{content:"";position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.8;
background-image:
radial-gradient(1px 1px at 8% 12%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 23% 42%,#fff 50%,transparent 51%),
radial-gradient(1.5px 1.5px at 37% 8%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 52% 31%,#fff 50%,transparent 51%),
radial-gradient(1px 1px at 66% 14%,#fff 50%,transparent 51%),radial-gradient(1.5px 1.5px at 81% 37%,#fff 50%,transparent 51%),
radial-gradient(1px 1px at 92% 9%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 14% 71%,#fff 50%,transparent 51%),
radial-gradient(1.5px 1.5px at 29% 88%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 47% 63%,#fff 50%,transparent 51%),
radial-gradient(1px 1px at 61% 82%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 76% 67%,#fff 50%,transparent 51%),
radial-gradient(1.5px 1.5px at 88% 91%,#fff 50%,transparent 51%),radial-gradient(1px 1px at 4% 46%,#fff 50%,transparent 51%),
radial-gradient(1px 1px at 97% 58%,#fff 50%,transparent 51%);background-size:100% 100%}
.wrap{position:relative;z-index:1;max-width:760px;margin:0 auto;padding:20px 18px 40px}
.frame{border:1px solid var(--line);outline:1px solid rgba(232,176,74,.18);outline-offset:6px;border-radius:4px;padding:34px 20px 30px;margin:10px 4px 28px}
.kicker{font-size:.74rem;letter-spacing:.28em;text-transform:uppercase;color:var(--gold);font-weight:700;text-align:center;margin:0}
.patch{display:block;margin:26px auto 10px;width:96px;height:96px}
h1{font-family:Georgia,"Times New Roman",serif;font-weight:400;text-align:center;font-size:clamp(2.6rem,11vw,4.2rem);line-height:1.02;margin:10px 0 14px}
.rule{width:120px;height:2px;margin:0 auto 14px;background:linear-gradient(90deg,transparent,var(--gold),transparent)}
.tagline{font-family:Georgia,serif;font-style:italic;text-align:center;color:var(--ink);font-size:1.2rem;margin:0 0 22px}
.when{text-align:center;margin:0 auto 6px;font-size:1.08rem}
.when strong{display:block;font-size:1.3rem;letter-spacing:.01em}
.where{text-align:center;color:var(--muted);margin:6px 0 0}
.change{display:inline-block;margin:16px auto 0;padding:6px 12px;border:1px dashed var(--orange);color:#ffd2b0;border-radius:999px;font-size:.82rem;letter-spacing:.06em;text-transform:uppercase;font-weight:700}
.center{text-align:center}
.btns{display:grid;gap:12px;margin:26px 0 6px}
.btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:58px;padding:14px 18px;border-radius:12px;font-weight:800;font-size:1.08rem;text-decoration:none;letter-spacing:.02em;border:2px solid var(--gold);transition:transform .08s ease}
.btn:active{transform:scale(.98)}
.btn.primary{background:linear-gradient(180deg,#f2c060,var(--gold));color:#1a1405}
.btn.ghost{background:rgba(11,29,58,.6);color:var(--ink)}
.btn svg{width:22px;height:22px;flex:none}
.note{font-size:.86rem;color:var(--muted);text-align:center;margin:8px 0 0}
section{background:var(--panel);border:1px solid rgba(185,196,218,.18);border-radius:14px;padding:22px 20px;margin:18px 0}
h2{font-size:.8rem;letter-spacing:.24em;text-transform:uppercase;color:var(--gold);margin:0 0 12px}
section p{margin:0 0 10px}
section p:last-child{margin-bottom:0}
dl{display:grid;grid-template-columns:96px 1fr;gap:8px 14px;margin:0}
dt{color:var(--gold);font-weight:700;font-size:.85rem;letter-spacing:.08em;text-transform:uppercase;padding-top:2px}
dd{margin:0}
a{color:#ffd28a}
ol.flight{list-style:none;margin:0;padding:0;counter-reset:s}
ol.flight li{position:relative;padding:0 0 12px 40px;counter-increment:s}
ol.flight li:last-child{padding-bottom:0}
ol.flight li:before{content:counter(s);position:absolute;left:0;top:0;width:26px;height:26px;border-radius:50%;border:1.5px solid var(--gold);color:var(--gold);font-weight:800;font-size:.8rem;display:flex;align-items:center;justify-content:center}
.stat{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0 0}
.stat span{flex:1 1 140px;border:1px solid var(--line);border-radius:10px;padding:10px 12px;text-align:center;font-size:.9rem;color:var(--muted)}
.stat b{display:block;color:var(--ink);font-size:1.25rem}
form{display:grid;gap:12px;margin-top:6px}
label{display:grid;gap:5px;font-size:.88rem;color:var(--muted);font-weight:600}
input,select{width:100%;font:inherit;font-size:1rem;color:var(--ink);background:rgba(6,18,41,.75);border:1px solid rgba(185,196,218,.35);border-radius:10px;padding:12px 12px;min-height:48px}
input:focus,select:focus{outline:2px solid var(--gold);outline-offset:1px;border-color:transparent}
button.btn{width:100%;cursor:pointer;font-family:inherit}
footer{text-align:center;color:var(--muted);font-size:.82rem;margin:30px 0 0}
footer p{margin:4px 0}
@media (min-width:620px){.btns{grid-template-columns:1.3fr 1fr 1fr}.frame{padding:44px 36px 36px}section{padding:26px 28px}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}}
</style>
</head>
<body>
<div class="wrap">

<header class="frame">
<p class="kicker">Austin From Houston Presents</p>
<svg class="patch" viewBox="0 0 100 100" aria-hidden="true">
<circle cx="50" cy="50" r="44" fill="#0b1d3a" stroke="#e9772e" stroke-width="5"/>
<circle cx="50" cy="50" r="36" fill="none" stroke="#e8b04a" stroke-width="1.2" opacity=".7"/>
<ellipse cx="50" cy="50" rx="47" ry="17" fill="none" stroke="#e8b04a" stroke-width="1.6" transform="rotate(-24 50 50)" opacity=".85"/>
<polygon points="50,22 57.6,40.5 77.6,41.9 62.3,54.7 67.1,74.1 50,63.6 32.9,74.1 37.7,54.7 22.4,41.9 42.4,40.5" fill="#f2c060" stroke="#c98d22" stroke-width="1"/>
</svg>
<h1>Space City<br>Exchange</h1>
<div class="rule"></div>
<p class="tagline">Houston, we have a network.</p>
<p class="when"><strong>Sunday, February 21, 2027</strong>6:30 PM to 9:30 PM CT</p>
<p class="where">The new CheckMate Real Estate office<br>1201 Fannin St Ste 350, Houston, TX 77002</p>
<div class="center"><span class="change">Date and time subject to change</span></div>

<div class="btns" id="rsvp">
<a class="btn primary" href="sms:+12817296604?&amp;body=I%20want%20my%20market%27s%20seat%20at%20Space%20City%20Exchange.%20Name%2C%20market%3A">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.9A8 8 0 1 1 21 12z"/></svg>Text Austin</a>
<a class="btn ghost" href="tel:+12817296604">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Call</a>
<a class="btn ghost" href="mailto:austin@checkmatere.com?subject=Space%20City%20Exchange%3A%20my%20market%27s%20seat&amp;body=Hi%20Austin%2C%0A%0AI%20would%20like%20my%20market%27s%20seat%20at%20Space%20City%20Exchange.%0A%0AName%3A%20%0ABrokerage%3A%20%0AMarket%3A%20%0AProduction%20(last%2012%20months%2C%20units%20and%20volume)%3A%20%0A%0AThank%20you!">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>Email Austin</a>
<a class="btn ghost" href="https://www.facebook.com/events/1404828064929844/" target="_blank" rel="noopener">RSVP on Facebook</a>
</div>
<p class="note">By invitation. Text or call 281.729.6604 to claim your market's seat.</p>
</header>

<section>
<h2>The Mission</h2>
<p>Space City Exchange is an invite-only referral network evening during KW Family Reunion 2027 in Houston. One night to meet the agents we trust to take care of our clients coast to coast, and to leave with a roster of people you can actually refer to.</p>
<dl>
<dt>When</dt><dd>Sunday, February 21, 2027<br>6:30 PM to 9:30 PM CT<br><em style="color:#ffd2b0">Date and time subject to change</em></dd>
<dt>Where</dt><dd>The new CheckMate Real Estate office<br>1201 Fannin St Ste 350, Houston, TX 77002<br>A short walk from the George R. Brown Convention Center. <a href="https://www.google.com/maps/search/?api=1&amp;query=1201+Fannin+St+Ste+350+Houston+TX+77002" rel="noopener">Map</a></dd>
<dt>During</dt><dd>KW Family Reunion 2027, February 19 to 22, 2027, George R. Brown Convention Center, Houston</dd>
</dl>
</section>

<section>
<h2>Who It's For</h2>
<p>Two to three hand-selected top agents from each of the top 50 U.S. markets, commercial and residential. Together we are building a national referral network of people we trust to take care of our clients coast to coast.</p>
<div class="stat"><span><b>50</b>top U.S. markets</span><span><b>2 to 3</b>agents per market</span><span><b>100 to 150</b>agents in the room</span></div>
</section>

<section>
<h2>Flight Plan</h2>
<ol class="flight">
<li>Arrival and check in with region-coded badges</li>
<li>Welcome from Austin</li>
<li>Structured referral rounds by region</li>
<li>Dinner or heavy appetizers</li>
<li>A short panel of top producers</li>
<li>Everyone joins the referral roster</li>
</ol>
</section>

<section>
<h2>Request Your Market's Seat</h2>
<p>Seats are limited to a few agents per market. Tell Austin who you are and he will follow up personally. Submitting opens your email app with a message ready to send; nothing is stored on this page.</p>
<form id="seat" novalidate>
<label>Name<input name="name" autocomplete="name" required></label>
<label>Brokerage<input name="brokerage" autocomplete="organization"></label>
<div class="two">
<label>Market (city, state)<input name="market" placeholder="e.g. Dallas, TX"></label>
<label>Focus<select name="focus"><option>Residential</option><option>Commercial</option><option>Both</option></select></label>
</div>
<label>Production (last 12 months, units and volume)<input name="production" placeholder="e.g. 60 units, $25M"></label>
<label>Mobile<input name="phone" type="tel" autocomplete="tel"></label>
<button class="btn primary" type="submit">Email My Request to Austin</button>
</form>
<p class="note">Prefer to text? <a href="sms:+12817296604?&amp;body=I%20want%20my%20market%27s%20seat%20at%20Space%20City%20Exchange.%20Name%2C%20market%3A">Text 281.729.6604</a></p>
</section>

<section>
<h2>Your Host</h2>
<p><strong>Austin Jones</strong>, Austin From Houston<br>CheckMate Real Estate, Keller Williams Houston Central</p>
<p>Phone or text: <a href="tel:+12817296604">281.729.6604</a><br>Email: <a href="mailto:austin@checkmatere.com?subject=Space%20City%20Exchange%3A%20my%20market%27s%20seat">austin@checkmatere.com</a></p>
</section>

<footer>
<p>Space City Exchange | Austin From Houston Presents</p>
<p>Family Reunion 2027 &middot; Houston, TX &middot; By Invitation</p>
<p>Date, time, and details subject to change.</p>
</footer>
</div>
<script is:inline>
document.getElementById('seat').addEventListener('submit',function(e){
e.preventDefault();
var f=e.target,v=function(n){return (f.elements[n].value||'').trim();};
if(!v('name')){f.elements.name.focus();return;}
var body='Hi Austin,\n\nI would like my market\'s seat at Space City Exchange.\n\n'+
'Name: '+v('name')+'\nBrokerage: '+v('brokerage')+'\nMarket: '+v('market')+'\nFocus: '+v('focus')+
'\nProduction (last 12 months): '+v('production')+'\nMobile: '+v('phone')+'\n\nThank you!';
window.location.href='mailto:austin@checkmatere.com?subject='+encodeURIComponent("Space City Exchange: my market's seat")+'&body='+encodeURIComponent(body);
});
</script>
</body>
</html>
