---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { SOCIAL, SITE_URL, REI101_EPISODES } from '../config/site';
import { breadcrumbSchema } from '../config/schema';

const title = 'REI 101 Podcast | Real Estate Investing with Austin from Houston';
const description =
  'REI 101 — the real estate investing podcast hosted by Austin Jones, "Austin from Houston" of Checkmate Real Estate. Plain-English lessons on investing in Houston and Pasadena, TX real estate.';
const crumbs = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'REI 101', url: '/rei-101/' },
]);
const podcastSchema = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'REI 101',
  description: 'A real estate investing podcast hosted by Austin Jones ("Austin from Houston") of Checkmate Real Estate, teaching the fundamentals of investing in Houston and Pasadena, TX real estate.',
  url: `${SITE_URL}/rei-101/`,
  webFeed: SOCIAL.youtube,
  author: { '@id': `${SITE_URL}/#austin` },
};

const topics = [
  { t: 'Your first deal', d: 'How to analyze, finance, and close your first investment property in the Houston metro.' },
  { t: 'Multifamily 101', d: 'Reading a rent roll, underwriting a duplex or fourplex, and avoiding rookie mistakes.' },
  { t: 'Commercial basics', d: 'Retail, industrial, and net lease explained for everyday investors.' },
  { t: 'Houston markets', d: 'Neighborhood-by-neighborhood breakdowns from Pasadena to Pearland.' },
];
---
<Base title={title} description={description} path="/rei-101/" schemas={[crumbs, podcastSchema]}>
  <PageHero
    eyebrow="The Podcast"
    title="REI 101 — real estate investing, in plain English"
    subtitle="Hosted by Austin from Houston. Real strategies for building wealth through Houston- and Pasadena-area real estate, no jargon required."
  />

  <section class="mx-auto max-w-5xl px-4 py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-3">
      <div class="md:col-span-2 space-y-5 text-lg leading-relaxed text-ink-800">
        <p>
          <strong>REI 101</strong> is where Austin Jones breaks down real estate investing
          for everyday people. Whether you’re eyeing your first rental in Pasadena or scaling a
          portfolio across Houston, each episode turns intimidating concepts into clear, actionable moves.
        </p>
        <p>
          It’s the same philosophy that drives Checkmate Real Estate: educate first, build trust,
          and help our Houston-area neighbors play a smarter game.
        </p>
        <h2 class="font-display text-2xl font-bold text-ink-900">What you’ll learn</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {topics.map((t) => (
            <div class="rounded-lg border border-ink-800/10 bg-white p-5">
              <h3 class="font-bold text-ink-900">{t.t}</h3>
              <p class="mt-1 text-base text-ink-700">{t.d}</p>
            </div>
          ))}
        </div>
      </div>

      <aside class="space-y-4">
        <div class="bg-ink-900 p-7 text-ivory-50">
          <p class="text-xs font-medium uppercase tracking-[0.30em] text-gold-500">Watch &amp; subscribe</p>
          <h2 class="mt-2 font-display text-xl font-medium text-ivory-50">REI 101 on YouTube</h2>
          <p class="mt-2 text-sm text-ivory-200">New episodes drop regularly on Austin's channel. Watch, subscribe, and hit the bell.</p>
          <a
            class="mt-5 block bg-gold-500 px-4 py-3 text-center text-xs font-medium uppercase tracking-[0.18em] text-ink-900 transition-colors hover:bg-gold-400"
            href={SOCIAL.youtube}
            target="_blank"
            rel="noopener"
          >Subscribe on YouTube</a>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="block border border-ivory-200/30 px-4 py-2.5 text-center font-medium hover:border-gold-400 hover:text-gold-400" href={SOCIAL.instagram} target="_blank" rel="noopener">Clips on Instagram</a></li>
            <li><a class="block border border-ivory-200/30 px-4 py-2.5 text-center font-medium hover:border-gold-400 hover:text-gold-400" href={SOCIAL.facebook} target="_blank" rel="noopener">Follow on Facebook</a></li>
          </ul>
          <p class="mt-4 text-xs text-ivory-300">Apple Podcasts &amp; Spotify links can be added once those feeds are live.</p>
        </div>
      </aside>
    </div>
  </section>

  {REI101_EPISODES.length > 0 && (
    <section class="border-t border-line bg-ivory-100">
      <div class="mx-auto max-w-6xl px-4 py-16 md:py-20">
        <p class="text-xs font-medium uppercase tracking-[0.30em] text-gold-500">From the channel</p>
        <h2 class="mt-2 font-display text-3xl font-medium md:text-4xl">Featured episodes</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {REI101_EPISODES.map((ep) => (
            <div>
              <div class="aspect-video w-full overflow-hidden border border-line bg-ink-900">
                <iframe
                  class="h-full w-full"
                  src={`https://www.youtube-nocookie.com/embed/${ep.id}`}
                  title={ep.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
              <p class="mt-3 font-display text-xl font-medium text-ink-900">{ep.title}</p>
            </div>
          ))}
        </div>
        <a
          class="mt-10 inline-block border border-ink-900 px-8 py-3.5 text-xs font-medium uppercase tracking-[0.18em] text-ink-900 transition-colors hover:bg-ink-900 hover:text-ivory-50"
          href={SOCIAL.youtube}
          target="_blank"
          rel="noopener"
        >See all episodes on YouTube</a>
      </div>
    </section>
  )}

  <CtaBand heading="Ready to go from listener to investor?" text="Austin and the Checkmate team will help you put REI 101 into practice in the Houston market." />
</Base>
