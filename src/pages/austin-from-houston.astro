---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { NAP, SOCIAL } from '../config/site';
import { breadcrumbSchema, personSchema } from '../config/schema';

const title = 'Austin from Houston | Austin Jones, Houston Real Estate Agent & Investor';
const description =
  'Austin from Houston — Austin Jones is a Houston and Pasadena, TX real estate agent, investor, and host of the REI 101 podcast. Founder of Checkmate Real Estate, brokered by Keller Williams.';
const crumbs = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Austin from Houston', url: '/austin-from-houston/' },
]);
// Reinforce the Person entity on the page that targets the personal-brand query.
const person = { '@context': 'https://schema.org', ...personSchema() };

const faqs = [
  {
    q: 'Who is Austin from Houston?',
    a: 'Austin from Houston is Austin Jones, a Houston- and Pasadena-based real estate agent and investor, and the founder of Checkmate Real Estate. He is brokered by Keller Williams and hosts the REI 101 real estate podcast.',
  },
  {
    q: 'What areas does Austin from Houston serve?',
    a: 'Austin serves the greater Houston metro, including Pasadena, Deer Park, La Porte, Friendswood, Pearland, League City, Baytown, and all of Harris County, TX.',
  },
  {
    q: 'What types of real estate does Austin handle?',
    a: 'Residential, multifamily, retail, industrial, and land — Austin works the full board of Houston-area real estate for both homeowners and investors.',
  },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base title={title} description={description} path="/austin-from-houston/" schemas={[crumbs, person, faqSchema]}>
  <PageHero
    eyebrow="The Person Behind the Brand"
    title="Austin from Houston"
    subtitle="Real estate agent. Investor. Operator. Houston native helping his neighbors win across Houston and Pasadena, TX."
  />

  <section class="mx-auto max-w-6xl px-4 py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-3">
      <div class="md:col-span-2 space-y-6 text-lg leading-relaxed text-ink-800">
        <h2 class="font-display text-2xl font-bold text-ink-900">Why “Austin from Houston”?</h2>
        <p>
          Ask around the Houston real estate scene and people don’t say “Austin Jones, the agent.”
          They say <strong>“Austin from Houston.”</strong> It stuck because it’s true — Austin is
          of this city. He knows its neighborhoods, its commutes, its industrial corridors along
          the Ship Channel, and the small-town feel of Pasadena and Deer Park just to the southeast.
        </p>
        <p>
          That local fluency, paired with an investor’s discipline, is the whole pitch. Austin
          doesn’t just open doors — he runs the numbers, reads the market, and tells you the truth
          about a deal, even when it’s not what you hoped to hear. It’s how he’s earned trust as the
          go-to name for Houston-area real estate.
        </p>

        <h2 class="font-display text-2xl font-bold text-ink-900">What Austin does</h2>
        <ul class="space-y-3 text-base">
          <li class="flex gap-3"><span class="text-gold-600 text-xl">♚</span><span><strong>Represents buyers &amp; sellers</strong> across residential and commercial real estate in Houston and Pasadena.</span></li>
          <li class="flex gap-3"><span class="text-gold-600 text-xl">♛</span><span><strong>Invests and advises</strong> on multifamily, retail, industrial, and land throughout the Gulf Coast.</span></li>
          <li class="flex gap-3"><span class="text-gold-600 text-xl">♜</span><span><strong>Hosts <a class="font-semibold text-gold-600 hover:underline" href="/rei-101/">REI 101</a></strong>, teaching real estate investing in plain English.</span></li>
          <li class="flex gap-3"><span class="text-gold-600 text-xl">♞</span><span><strong>Leads Checkmate Real Estate</strong>, brokered by Keller Williams.</span></li>
        </ul>

        <h2 class="font-display text-2xl font-bold text-ink-900">Frequently asked</h2>
        <dl class="space-y-5">
          {faqs.map((f) => (
            <div class="rounded-lg border border-ink-800/10 bg-white p-5">
              <dt class="font-bold text-ink-900">{f.q}</dt>
              <dd class="mt-2 text-base text-ink-700">{f.a}</dd>
            </div>
          ))}
        </dl>
      </div>

      <aside class="space-y-6">
        <img
          src="/team/austin.jpg"
          alt="Austin Jones — Austin from Houston, Houston &amp; Pasadena real estate agent"
          width="760"
          height="900"
          class="w-full border border-line object-cover"
        />
        <div class="bg-ink-900 p-7 text-ivory-50">
          <p class="font-display text-xl font-medium">Austin Jones</p>
          <p class="text-xs font-medium uppercase tracking-[0.18em] text-gold-300">Austin from Houston</p>
          <p class="mt-4 text-sm text-ivory-200">Founder, Checkmate Real Estate · Brokered by Keller Williams · Host of REI 101.</p>
          <div class="mt-6 space-y-2 text-sm">
            <a class="block rounded-md bg-gold-500 px-4 py-2.5 text-center font-semibold text-ink-900 hover:bg-gold-400" href="/contact/">Work with Austin</a>
            <a class="block rounded-md border border-ivory-200/30 px-4 py-2.5 text-center font-semibold hover:border-gold-400 hover:text-gold-400" href={NAP.directPhoneHref}>Call Austin direct: {NAP.directPhone}</a>
          </div>
          <div class="mt-6 flex flex-wrap gap-3 border-t border-ink-700 pt-5 text-sm">
            <a class="text-ivory-200 hover:text-gold-300" href={SOCIAL.instagram}>Instagram</a>
            <a class="text-ivory-200 hover:text-gold-300" href={SOCIAL.youtube}>YouTube</a>
            <a class="text-ivory-200 hover:text-gold-300" href={SOCIAL.linkedin}>LinkedIn</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand heading="Make your next move with Austin" text="Houston, Pasadena, and the whole Gulf Coast. Let’s talk about your goals." />
</Base>
