---
import Base from '../layouts/Base.astro';
import { NAV } from '../config/site';
const title = 'Page Not Found | Checkmate Real Estate';
const description = 'That page couldn’t be found. Explore Checkmate Real Estate — Houston and Pasadena, TX.';
---
<Base title={title} description={description} noindex={true}>
  <section class="checker-bg bg-ink-900 text-ivory-50">
    <div class="mx-auto max-w-3xl px-4 py-24 text-center">
      <p class="font-display text-6xl font-bold text-gold-400">Checkmate.</p>
      <h1 class="mt-4 text-3xl font-medium text-ivory-50">That page is off the board</h1>
      <p class="mt-3 text-ivory-200">The page you’re looking for doesn’t exist — but your next move does.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-2">
        {NAV.map((item) => (
          <a href={item.href} class="rounded-full border border-ivory-200/30 px-4 py-2 text-sm font-medium hover:border-gold-400 hover:text-gold-400">{item.label}</a>
        ))}
      </div>
    </div>
  </section>
</Base>
